{
  "openapi": "3.1.0",
  "info": {
    "title": "kda-indexer native API",
    "description": "Internal and unstable until a public hostname is decided. JSON in snake_case. List routes take limit (1..=100, default 20), an opaque cursor, order (desc default, asc), minheight, maxheight and chain, and answer {items, next_cursor, as_of}. A filtered page can be shorter than limit while next_cursor is set: follow it until it is null. A cursor whose block was reorged away answers 400 'cursor invalidated by reorg'. Balances and tokens come from /local reconciles: every balance row carries as_of_height and stale. Search routes run under a shared gate (503 when search.concurrency searches run, 429 when the client already runs search.per_client) and answer truncated: true when their deadline or a cap cut them. NFT holdings come from marmalade ledger events and /local (source event or local).",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "1"
  },
  "paths": {
    "/api/v1/accounts/{account}/balances": {
      "get": {
        "tags": [
          "balances"
        ],
        "summary": "Current balances of an account per token and chain.",
        "operationId": "account_balances",
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "description": "Account name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "token",
            "in": "query",
            "description": "Token module (default: every token)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chain",
            "in": "query",
            "description": "Chain id",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1..=100, default 100",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque page cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`items` of {module, chain, balance, guard, as_of_height, stale}, `next_cursor`, `as_of`"
          }
        }
      }
    },
    "/api/v1/accounts/{account}/transfers": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Transfers of `token` (default `coin`) with the account on either side, newest first;\na cross-chain pair is resolved from the same tx's events.",
        "operationId": "transfers",
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "description": "Account name",
            "required": true,
            "schema": {
              "type": "string"
