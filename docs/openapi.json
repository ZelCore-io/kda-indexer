    "/api/v1/stats": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Exact user-tx and block counts, per-chain frozen counts and the indexed tips.",
        "operationId": "stats",
        "responses": {
          "200": {
            "description": "Counts and per-chain frozen counts"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "crate::status"
        ],
        "summary": "Network, per-chain node and indexed tips, lag, halted chains, frozen frontier.",
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Indexer status"
          }
        }
      }
    },
    "/api/v1/txs/{request_key}": {
      "get": {
        "tags": [
          "txs"
        ],
        "summary": "Full tx by request key, with its block.",
        "operationId": "get_tx",
        "parameters": [
          {
            "name": "request_key",
            "in": "path",
            "description": "Request key (43-char base64url)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "`proof` adds the SPV proof of a continuation tx (it can be large).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tx: command, signers with capabilities, sigs, result, events, transfers, continuation, block info"
          },
          "400": {
            "description": "Not a request key"
          },
          "404": {
            "description": "Unknown request key"
          }
        }
      }
    }
  },
  "components": {}
}
