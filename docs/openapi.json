            "name": "module",
            "in": "query",
            "description": "Exact module, e.g. `coin` or `free.token`",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Exact event name, e.g. `TRANSFER`; needs `module`, or write it qualified (`coin.TRANSFER`)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "param0",
            "in": "query",
