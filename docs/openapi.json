              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Block"
          },
          "404": {
            "description": "No such block"
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Events by module and name (a qualified `name` such as `coin.TRANSFER` is split at its last dot\nwhen `module` is absent). At least one of `module`, `name`, `param{N}` is required.",
        "operationId": "list",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1..=100 (default 20).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque token of the previous page's `next_cursor`.",
            "required": false,
