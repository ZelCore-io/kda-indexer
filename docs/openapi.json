      "get": {
        "tags": [
          "txs"
        ],
        "summary": "Every stored step of the defpact a tx starts or continues, ascending: the starting exec\n(step 0) and each `cont` (its `payload.cont.step` and `rollback`), with its outcome.",
        "operationId": "defpact",
        "parameters": [
          {
            "name": "request_key",
            "in": "path",
