          },
          {
            "name": "chain",
            "in": "query",
            "description": "Only this chain (0..19).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "module",
            "in": "query",
            "description": "Exact module, e.g. `coin` or `free.token`",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Exact event name, e.g. `TRANSFER`; needs `module`, or write it qualified (`coin.TRANSFER`)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "param0",
            "in": "query",
            "description": "Exact string value of event parameter 0 (param0..param9)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`items` of events with their tx context, `next_cursor`, `as_of`"
          }
        }
      }
    },
