              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "`desc` (default, newest first) or `asc`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minheight",
            "in": "query",
            "description": "Lowest height (inclusive).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
