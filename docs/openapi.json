            "description": "Opaque page cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`items` of {module, first_height, holders, holders_approx}, `next_cursor`, `as_of`"
