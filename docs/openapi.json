            "in": "query",
            "description": "Only this chain (0..19).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "chains",
            "in": "query",
            "description": "Comma-separated chain ids",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`items` of blocks (no coinbase), `next_cursor`, `as_of`"
          }
        }
      }
    },
    "/api/v1/blocks/{hash}": {
      "get": {
        "tags": [
          "blocks"
        ],
        "summary": "Block by hash: header, miner, coinbase, tx count, confirmations.",
        "operationId": "by_hash",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
