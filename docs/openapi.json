{
  "openapi": "3.1.0",
  "info": {
    "title": "kda-indexer native API",
    "description": "Internal and unstable until a public hostname is decided. JSON in snake_case. List routes take limit (1..=100, default 20), an opaque cursor, order (desc default, asc), minheight, maxheight and chain, and answer {items, next_cursor, as_of}. A filtered page can be shorter than limit while next_cursor is set: follow it until it is null. A cursor whose block was reorged away answers 400 'cursor invalidated by reorg'. Routes reserved for P6 answer 501 {\"error\": \"not implemented until P6\"}: /txs/{requestKey}/defpact, /accounts/{account}/balances, /keys/{pubkey}/accounts, /tokens, /tokens/{module}, /search/code, /search/events, /nft/accounts/{account}.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "1"
  },
  "paths": {
    "/api/v1/accounts/{account}/transfers": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Transfers of `token` (default `coin`) with the account on either side, newest first;\na cross-chain pair is resolved from the same tx's events.",
        "operationId": "transfers",
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "description": "Account name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1..=100 (default 20).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque token of the previous page's `next_cursor`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "`desc` (default, newest first) or `asc`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minheight",
            "in": "query",
            "description": "Lowest height (inclusive).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "maxheight",
            "in": "query",
            "description": "Highest height (inclusive).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "chain",
            "in": "query",
            "description": "Only this chain (0..19).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "token",
            "in": "query",
            "description": "Token module, default `coin`",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`items` of transfers, `next_cursor`, `as_of`"
          }
        }
      }
    },
