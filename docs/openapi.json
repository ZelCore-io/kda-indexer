          {
            "name": "order",
            "in": "query",
            "description": "`desc` (default, newest first) or `asc`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minheight",
            "in": "query",
            "description": "Lowest height (inclusive).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "maxheight",
            "in": "query",
            "description": "Highest height (inclusive).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "chain",
            "in": "query",
            "description": "Only this chain (0..19).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`items` of events with their tx context, `next_cursor`, `truncated`, `as_of`"
          },
          "400": {
            "description": "q missing, too short or too long"
          },
          "429": {
            "description": "This client already runs a search"
          },
          "503": {
            "description": "Too many searches in flight"
          }
        }
