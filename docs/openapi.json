    "/api/v1/search/code": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Code search: txs whose exec code contains `q`.",
        "operationId": "code",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "LIKE pattern matched anywhere in the exec code; needs search.min_len characters other than wildcards and a run of 3 without wildcards",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1..=100 (default 20).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque token of the previous page's `next_cursor`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "`desc` (default, newest first) or `asc`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minheight",
            "in": "query",
            "description": "Lowest height (inclusive).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "maxheight",
            "in": "query",
            "description": "Highest height (inclusive).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "chain",
            "in": "query",
            "description": "Only this chain (0..19).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`items` of tx summaries, `next_cursor`, `truncated`, `partial`, `as_of`"
          },
          "400": {
            "description": "q missing, too short, too long or without a 3-character run"
          },
          "429": {
            "description": "This client already runs a search"
          },
          "503": {
            "description": "Too many searches in flight, or no code index built"
          }
        }
      }
    },
