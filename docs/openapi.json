            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minheight",
            "in": "query",
            "description": "Lowest height (inclusive).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "maxheight",
            "in": "query",
            "description": "Highest height (inclusive).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "chain",
            "in": "query",
            "description": "Only this chain (0..19).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "role",
            "in": "query",
            "description": "`any` (default) or `sender` (meta sender)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`items` of tx summaries, `next_cursor`, `as_of`"
          }
        }
      }
    },
    "/api/v1/blocks": {
      "get": {
        "tags": [
          "blocks"
        ],
        "summary": "Blocks by height window, newest first, ordered by (height, chain). `chains=0,3` limits the\nchains; `minheight`/`maxheight` bound the window (default: the newest heights).",
