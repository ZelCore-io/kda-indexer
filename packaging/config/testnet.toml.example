# kda-indexer, testnet instance (unit kda-indexer-testnet.service). Ports differ from mainnet01 so both can
# run on one host. Every <placeholder> must be replaced; `config check` refuses it otherwise.
# The testnet network id is not settled yet (open question B2/Q6); fill in the real one.
# Install as /opt/coins/kda-indexer/testnet/config/testnet.toml with a copy of the unit
# (kda-indexer-testnet.service) pointing at it; see install.md.
network = "<testnet-network-id>"
data_dir = "/opt/coins/data/kadena/kda-indexer/testnet"

[node]
url = "http://<testnet-node-host>:31351"   # service API of a testnet chainweb-node
# p2p_url = "https://127.0.0.1:31350"   # fallback, self-signed
# p2p_cert_sha256 = "..."               # pin
timeout_ms = 30000
max_body_bytes = 67108864               # per response, after decompression
max_sse_event_bytes = 1048576           # one /header/updates event

[ingest]
finality_depth = 1000
batch_size = 50
node_concurrency = 8
max_rps = 200

[storage]
mdbx_max_gb = 64                        # MDBX map upper bound
mdbx_growth_mb = 256                    # MDBX growth step

[backfill]
ranges_in_flight = 2
range_heights = 100000
step_heights = 10000                    # range_heights must be a multiple; dev configs use 1000/100
min_free_gb = 60
# max_rps = 200                         # defaults to ingest.max_rps
zstd_level = 19
dict_samples = 20000
etl_mem_mb = 1024                       # raw spool buffer per range before spilling to etl/
mem_cap_mb = 6144                       # byte budget: (ranges_in_flight + 1) x etl_mem_mb + writer; WARN above it

[freezer]
zstd_level = 9

[tail]
commit_ms = 1000
commit_blocks = 40
cut_poll_secs = 10

[api]
native = "<private-lan-ip>:31371"   # internal only: loopback or private (RFC 1918/4193)
compat = "127.0.0.1:31372"          # loopback until P8 (public behind the proxy then)
graphql = "127.0.0.1:31373"         # GraphQL; loopback until the G4 host config
admin = "127.0.0.1:31379"           # loopback or private only
trusted_proxies = ["<proxy-private-ip>"]   # IP or CIDR; X-Forwarded-For only from these
rate_per_ip = 20          # requests/s per client IP (429 past it)
rate_burst = 40
deadline_ms = 5000        # per request (504 past it)
max_in_flight = 512       # over all listeners (503 past it)
max_body_mb = 8           # response cap (503 "narrow the query" past it)
v1txs_max_body_mb = 32    # response cap of /v1/txs
read_threads = 4          # concurrent store reads
ready_max_lag = 20        # /readyz: max blocks a chain may lag the node (a halted chain is never ready)
max_event_lists = 256     # event-name lists one event query may expand to


[graphql]
# GraphQL limits (docs/graphql.md); the listener address is api.graphql. All optional.
# default_page = 20          # page size when first/last are omitted
# max_page = 100             # larger first/last are clamped to this
# max_depth = 10
# max_complexity = 2000
# introspection = true
# introspection_depth = 14   # introspection is exempt from max_depth, capped here
# max_batch = 10             # operations per batched request (N rate tokens)
# max_query_bytes = 32768
# max_variables_bytes = 65536
# ws_subs_per_conn = 20
# ws_subs_max = 2000
# ws_conns_per_ip = 10
# ws_init_secs = 10
# ws_idle_secs = 600
# ws_tx_wait_secs = 3600
# feed_poll_ms = 1000
# network_host = ""          # networkInfo.networkHost: a public name, never the node URL

[search]
min_len = 4               # literal chars name/param need without modulename (search has no minimum)
max_results = 100
max_candidates = 10000
max_scan_heights = 20000
timeout_ms = 2000
mode = "auto"              # code index (S-1): auto (decided by the projection), full, fallback
fallback_min_len = 0       # fallback: index bodies of at least this many bytes plus modules; 0 = from the projection
commit_secs = 60           # tail stage commit period
concurrency = 4            # concurrent searches (all search routes); more answer 503
per_client = 1             # concurrent searches per client; more answer 429
build_threads = 2          # search rebuild threads
heap_mb = 512              # search rebuild writer heap
periodic_rebuild = true    # in-process rebuild that keeps the expansion window short; false = off
rebuild_days = 7           # rebuild when the index is this old (0 = never by age)
rebuild_window_heights = 30000   # or when tip - rebuilt_through_height reaches this (0 = never)

[balances]
enabled = true             # seed and /local reconciler inside run (B-5)
local_rps = 50             # /local calls per second
local_concurrency = 8      # /local calls in flight
# Modules GET /keys/{pk}/accounts lists without ?token= (SEC-2). Any module can implement
# fungible-v2 and report a balance under any key: list only modules you trust.
# key_modules = ["coin"]

[metrics]
textfile = "/var/lib/node_exporter/textfile_collector/kda_indexer_testnet.prom"   # optional

[log]
format = "text"    # or "json"
level = "info"
