# kda-compare configuration (spec section 7). Copy to compare.local.toml (gitignored).
network = "mainnet01"
rate_rps = 5.0          # total across all targets
timeout_ms = 30000
follow_depth = 3        # pages followed via Chainweb-Next
min_depth = 10          # sample heights at min(tip) - 10
node_max_rps = 50       # node oracle and generator requests (own limit)
allowlist = "compare/allowlist.toml"
seeds = "compare/seeds/mainnet01.toml"
# replay = "test-runs/replay-2026-11-08.tsv"   # from `kda-compare replay-import`
out_dir = "test-runs/compare"
metrics_bind = "127.0.0.1:31369"
max_body_bytes = 8388608   # per target response, after decompression
# (A, B): B is a target name or "node" (the node oracle).
pairs = [["cwd", "node"]]

[node]
url = "http://127.0.0.1:31351"
timeout_ms = 30000
max_body_bytes = 67108864       # per node response, after decompression
max_sse_event_bytes = 1048576   # one /header/updates event

[targets.cwd]
url = "http://127.0.0.1:31352"
kind = "chainweb_data"

# [targets.compat]
# url = "http://127.0.0.1:31362"
# kind = "kda_indexer_compat"

[mix]
replay = 0.5
random = 0.4
seeds = 0.1
