# One unit per network (Blockbook layout): binary and config under
# /opt/coins/kda-indexer/<network>/, data under /opt/coins/data/kadena/kda-indexer/<network>/.
# For another network copy this file as kda-indexer-<network>.service and replace mainnet01.
[Unit]
Description=kda-indexer (mainnet01)
Documentation=file:///usr/share/doc/kda-indexer/install.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=notify
User=kda-indexer
Group=kda-indexer
ExecStart=/opt/coins/kda-indexer/mainnet01/bin/kda-indexer run --config /opt/coins/kda-indexer/mainnet01/config/mainnet01.toml
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
WatchdogSec=120
LimitNOFILE=1048576
# Share the host fairly with chainweb-node. MemoryHigh/MemoryMax are defaults for a 23 GiB
# host; set yours in a drop-in (examples/memory.conf).
Nice=5
CPUWeight=50
IOWeight=50
MemoryHigh=12G
MemoryMax=16G
# Anonymous memory never swaps; reclaim under MemoryHigh takes page cache only (run MEM).
MemorySwapMax=0
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/coins/data/kadena/kda-indexer/mainnet01
# optional textfile metrics; the leading '-' ignores a missing dir
ReadWritePaths=-/var/lib/node_exporter/textfile_collector
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
